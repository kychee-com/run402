# Supply-chain guards for installs of this package's own workspace, the same
# two the platform monorepo's root .npmrc sets (npm reads a project's .npmrc
# only for that project). They protect contributors and CI; a customer's
# install of the published packages follows the customer's own npm settings.
#
# No dependency runs an install script: install scripts are how npm worms
# spread. esbuild (through tsx, a development dependency) finds its platform
# binary through its optional dependency without its postinstall. The setting
# also skips the cli and sdk prepack, so every `npm pack` and `npm publish` of
# them passes --ignore-scripts=false (.github/workflows/publish.yml,
# scripts/publish-idempotent.sh).
ignore-scripts=true
# A version published less than a week ago is not installed: most malicious
# releases are caught and pulled within days. Run402's own packages are exempt.
# npm 10 (Node 22's) ignores these two keys with a warning; npm 11 applies them.
min-release-age=7
min-release-age-exclude[]=run402
min-release-age-exclude[]=run402-mcp
min-release-age-exclude[]=@run402/*
loglevel=silent
