---
// Hosted-auth chrome straight from @run402/astro: <SignedIn>/<SignedOut> read
// the cookie-session actor server-side; <UserButton> renders the email + a
// CSRF-protected sign-out form. No fetch, no client auth code.
import { SignedIn, SignedOut, UserButton } from "@run402/astro/components";
---

<header
  style="display:flex;align-items:center;gap:16px;max-width:980px;margin:0 auto;padding:14px 18px;border-bottom:1px solid var(--line);"
>
  <a href="/" style="font-weight:800;font-size:1.1rem;color:var(--ink);">😈 EvilMe</a>
  <nav style="display:flex;gap:14px;font-size:.92rem;">
    <a href="/gallery">Gallery</a>
    <a href="/arena">Arena</a>
    <a href="/leaderboard">Leaderboard</a>
  </nav>
  <div style="margin-left:auto;">
    <SignedIn>
      <UserButton returnTo="/" />
    </SignedIn>
    <SignedOut>
      <a class="btn" href="/auth/sign-in?returnTo=/">Sign in</a>
    </SignedOut>
  </div>
</header>
