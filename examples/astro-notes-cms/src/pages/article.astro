---
import { db } from '@run402/functions';
import Run402Image from '@run402/astro/components/Run402Image.astro';
const article = await db().from('articles').select('title,body,hero_asset').eq('slug', 'welcome').maybeSingle();
if (!article) return new Response('Article not found', { status: 404 });
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---
<html lang="en"><head><meta charset="utf-8"/><title>{article.title}</title></head><body>
<h1>{article.title}</h1><p>{article.body}</p>
{article.hero_asset && <Run402Image asset={article.hero_asset} alt={article.title}/>}
<a href="/">Home</a></body></html>
