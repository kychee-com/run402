{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "maintenance_stage_claim_set.json",
 "title": "r402s/v0 maintenance_stage_claim_set (DRAFT rev 41) — paged ROOT; CANONICAL PACKING: every page except the final one holds exactly 10,000 candidates, batch_count = page_count = ceil(candidate_count/10000); stage_candidate_stored_size_bytes = sum of candidate size_bytes (D_stage — deletion/accounting EVIDENCE only, never re-charged) and stage_metadata_stored_size_bytes = root + all page stored bytes (A_stage — the NET-NEW admission charge inside the R terms); candidates == expected_stage(role) byte-for-byte; root+pages become pruneable once the cycle's terminal reaches TERMINAL_APPLIED",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "format",
  "object_kind",
  "suite",
  "object_id",
  "repo_id",
  "maintenance_cycle_id",
  "maintenance_prune_role",
  "candidate_count",
  "batch_count",
  "stage_candidate_stored_size_bytes",
  "stage_metadata_stored_size_bytes",
  "page_receipts",
  "writer_key_id",
  "signature"
 ],
 "properties": {
  "format": {
   "$ref": "common.json#/$defs/format"
  },
  "object_kind": {
   "const": "maintenance_stage_claim_set"
  },
  "suite": {
   "$ref": "common.json#/$defs/suite"
  },
  "object_id": {
   "$ref": "common.json#/$defs/msc"
  },
  "repo_id": {
   "$ref": "common.json#/$defs/src"
  },
  "maintenance_cycle_id": {
   "$ref": "common.json#/$defs/mc"
  },
  "maintenance_prune_role": {
   "enum": [
    "intermediate",
    "final"
   ]
  },
  "candidate_count": {
   "type": "string",
   "pattern": "^[1-9][0-9]{0,7}$"
  },
  "batch_count": {
   "type": "string",
   "pattern": "^[1-9][0-9]{0,3}$"
  },
  "page_receipts": {
   "type": "array",
   "minItems": 1,
   "maxItems": 4096,
   "items": {
    "$ref": "common.json#/$defs/receipt_maintenance_stage_page"
   }
  },
  "writer_key_id": {
   "$ref": "common.json#/$defs/vk"
  },
  "signature": {
   "$ref": "common.json#/$defs/signature"
  },
  "stage_candidate_stored_size_bytes": {
   "$ref": "common.json#/$defs/size_bytes"
  },
  "stage_metadata_stored_size_bytes": {
   "$ref": "common.json#/$defs/size_bytes"
  }
 },
 "x-r402s-revision": "41"
}
